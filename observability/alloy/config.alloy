// Loki write endpoint
loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
    tenant_id = "local"
  }
}

// Docker container logs scraping
loki.source.file "docker_logs" {
  targets = [
    {
      __path__ = "/var/lib/docker/containers/*/*-json.log",
      job      = "docker",
    },
  ]
  forward_to = [loki.write.local.receiver]
}

// Targeting developemnt files as a target
local.file_match "development_logs" {
  path_targets = [{"__path__" = "/development_logs/*.log"}]
  sync_period = "1s"
}

// Targeting app logs as a target
local.file_match "app_logs" {
  path_targets = [{"__path__" = "/app_logs/*.log"}]
  sync_period = "1s"
}

// Forwarding development logs to Loki
loki.source.file "development_logs" {
  targets = local.file_match.development_logs.targets
  forward_to = [loki.process.add_new_label.receiver]
}

// Forwarding app logs to Loki
loki.source.file "app_logs" {
  targets = local.file_match.app_logs.targets
  forward_to = [loki.process.add_new_label.receiver]
}

// Formatting Loki mapping
loki.process "add_new_label" {
  // Log debug info to see what's being processed
  stage.output {
    source = "output"
  }

  stage.regex {
    expression = "^(?P<timestamp>[^ ]+ [^ ]+) - (?P<logger>[^ ]+) - (?P<level>[^ ]+) - (?P<filename>[^ ]+) - (?P<lineno>\\d+) - (?P<funcName>[^ ]+) - (?P<process>\\d+) - (?P<thread>\\d+) - (?P<threadName>[^ ]+) - (?P<message>.*)$"
  }

  stage.labels {
    values = {
      "level"      = "level",
      "logger"     = "logger",
      "filename"   = "filename",
      "funcName"   = "funcName",
    }
  }

  forward_to = [loki.write.local.receiver]
}