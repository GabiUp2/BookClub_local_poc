# Copy to .env and adjust as needed for local development.

# Runtime environment
# APP_ENV controls behaviour like logging verbosity, feature toggles, etc.
APP_ENV="local"

# LLM providers (choose one or both)
# OPENAI_API_KEY=sk-...
GEMINI_API_KEY="asd..." # https://aistudio.google.com/api-keys
GEMINI_MODEL="gemini-2.5-flash" # name of the model to be used

# For Linux, if host.docker.internal is unavailable, use the host IP (e.g. http://172.17.0.1:11434)
OLLAMA_HOST="http://host.docker.internal:11434"

# Logging configuration
LOGS_LEVEL="INFO"
LOGS_FORMAT="%(asctime)s - %(name)s - %(levelname)s - %(filename)s - %(lineno)d - %(funcName)s - %(process)d - %(thread)d - %(threadName)s - %(message)s"
LOG_DIR="/logs"

# Prometheus multiprocess (Gunicorn) metrics temp dir
PROMETHEUS_MULTIPROC_DIR="/tmp/prometheus_multiproc_dir"

# Local service URLs (used by tests and docs)
PROM_URL="http://localhost:9090"
LOKI_URL="http://localhost:3100"
PUSHGATEWAY_URL="http://localhost:9091"
SERVER_URL="http://localhost:8010"
SERVER_BASE="http://localhost:8010"
APP_URL="http://localhost:8000"

# Test metrics labelling (pytest → Pushgateway)
PROM_JOB="pytest"
PROM_INSTANCE="local"
PROM_EXTRA_TAGS=""
PROM_CLEANUP="after"

# Vector DB (future use)
QDRANT_URL="http://localhost:6333"
