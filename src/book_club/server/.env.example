# Book Club Server Environment Variables
# FastAPI backend running on port 8010

# Application Configuration
APP_ENV=local
HOST=0.0.0.0
PORT=8010
START_POINT=server_main:server

# Gunicorn Configuration
GUNICORN_WORKERS=4

# Prometheus Configuration
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus_multiproc_dir

# AI/ML Configuration
# Replace with your actual OpenAI API key
OPENAI_API_KEY=your_openai_api_key_here
# Ollama host for local AI models
OLLAMA_HOST=http://host.docker.internal:11434

# Database Configuration
# Qdrant vector database connection
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# Cross-Origin Resource Sharing for FastAPI backand configuration
# Allowed origins for CORS (comma-separated)
CORS_ORIGINS=http://localhost:8000,http://bookclub-app:8000
