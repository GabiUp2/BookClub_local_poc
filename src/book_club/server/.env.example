# Book Club Server Environment Variables
# FastAPI backend running on port 8010

# Application Configuration
APP_ENV=local
HOST=0.0.0.0
PORT=8010
START_POINT=server_main:server

# Gunicorn Configuration
GUNICORN_WORKERS=4

# Prometheus Configuration
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus_multiproc_dir

# OTEL:
OTEL_EXPORTER_OTLP_ENDPOINT =  http://grafana-agent:4318
OTEL_SERVICE_NAME = "bookclub-server" # (overrides service.name)
OTEL_EXPORTER_OTLP_HEADERS = "" # OTEL_RESOURCE_ATTRIBUTES etc. (standard OTEL)
ENABLE_OTEL_LOGS=true # to export Python logs via OTLP
ENABLE_OTEL_METRICS=true # to export OTEL metrics (Prometheus still served on /metrics

# AI/ML Configuration
# Replace with your actual OpenAI API key
OPENAI_API_KEY=your_openai_api_key_here
# Ollama host for local AI models
OLLAMA_HOST=http://host.docker.internal:11434

# Database Configuration
# Qdrant vector database connection
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# CORS Configuration
# Allowed origins for CORS (comma-separated)
CORS_ORIGINS=http://localhost:8000,http://bookclub-app:8000
