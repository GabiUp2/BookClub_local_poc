# Book Club Server Environment Variables
# FastAPI backend running on port 8010

# Application Configuration
APP_ENV=local
HOST=0.0.0.0
PORT=8010
START_POINT=server_main:server

# Gunicorn Configuration
GUNICORN_WORKERS=4

# Prometheus Configuration
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus_multiproc_dir

# OTEL (traces go: app -> Alloy:4318 -> Tempo; view in Grafana Explore -> Tempo)
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318
OTEL_SERVICE_NAME=bookclub-preprocessing-server
# ENABLE_OTEL_TRACING=true  # default; set false to disable
ENABLE_OTEL_LOGS=true
# ENABLE_OTEL_METRICS=true  # optional; Prometheus still served on /metrics

# AI/ML Configuration
# Replace with your actual OpenAI API key
OPENAI_API_KEY=your_openai_api_key_here
# Ollama host for local AI models
OLLAMA_HOST=http://host.docker.internal:11434

# Database Configuration
# Qdrant vector database connection
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# CORS Configuration
# Allowed origins for CORS (comma-separated)
CORS_ORIGINS=http://localhost:8000,http://bookclub-app:8000
