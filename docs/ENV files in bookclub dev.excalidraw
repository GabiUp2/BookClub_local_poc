      "seed": 124638533,
      "version": 422,
      "versionNonce": 955660555,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1761396663257,
      "link": null,
      "locked": false,
      "text": "Docker compose allows either to directly set variables in container or target\nthe .env file that will be read on init.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Docker compose allows either to directly set variables in container or target\nthe .env file that will be read on init.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "KfvBStONOJaDThTe6JBhh",
      "type": "text",
      "x": 1567,
      "y": 400,
      "width": 761.919677734375,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1y",
      "roundness": null,
      "seed": 463821868,
      "version": 548,
      "versionNonce": 1544343188,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1761407723673,
      "link": null,
      "locked": false,
      "text": "Precedence:\n1. If Docker Compose is written first, \n    search for a variable in the environment\n    Then the top `.env` file values will have precedence.\n    e.g \"TOP_ENV_FILE: ${TOP_ENV_FILE:-DOCKER_COMPOSE_DIRECT}\"\n2. Docker Compose direct variable set, or if set as default value\n    and .env not avaible then default is used\n3. local .env file\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Precedence:\n1. If Docker Compose is written first, \n    search for a variable in the environment\n    Then the top `.env` file values will have precedence.\n    e.g \"TOP_ENV_FILE: ${TOP_ENV_FILE:-DOCKER_COMPOSE_DIRECT}\"\n2. Docker Compose direct variable set, or if set as default value\n    and .env not avaible then default is used\n3. local .env file\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
