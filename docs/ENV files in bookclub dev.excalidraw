    {
      "id": "hPQ2lYdYiJ5ufNKWMojVh",
      "type": "text",
      "x": 381,
      "y": 195,
      "width": 748.5394287109375,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
